{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@mnemonima/core": ["packages/core/src/index.ts"],
      "@mnemonima/store": ["packages/store/src/index.ts"],
      "@mnemonima/engine": ["packages/engine/src/index.ts"],
      "@mnemonima/daemon": ["packages/daemon/src/index.ts"],
      "@mnemonima/mcp": ["packages/mcp/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "vitest.config.ts"],
  // The UI is browser code: it needs the DOM lib and a bundler resolution, so
  // it carries its own tsconfig and is typechecked by its own build.
  "exclude": ["packages/ui"]
}
